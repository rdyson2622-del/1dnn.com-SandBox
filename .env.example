# Create a free project at https://supabase.com, then copy these values from
# Project Settings > API. The anon key is designed to be used by the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only secrets are configured in Supabase Edge Functions, never in this file:
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# DNN_CRON_SECRET=the-same-long-random-value-used-by-the-cron-setup-script
# DNN_NATIONAL_ARTICLE_COUNT=5
# DNN_LOCAL_ARTICLE_COUNT=10
# DNN_ARTICLE_RETENTION_DAYS=2
